# ---- Core ----
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://aidopost:aidopost@localhost:5432/aidopost
# Optional locally: without REDIS_URL jobs run in-process (no separate worker needed)
REDIS_URL=redis://localhost:6379

# ---- Auth (Auth.js) ----
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# "common" accepts personal + work accounts
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Transactional email (verification / password reset). Without a key, links are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="AidoPost <hello@aidopost.com>"

# ---- AI ----
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_PROMPT_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# Confirm current IDs on the official Gemini API docs before launch
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image-preview
FEATURE_FIDELITY_CHECK=false
# Local/CI only: fake Claude + Gemini so the flow runs without API keys
AI_MOCK=false
# Brand-name search (optional). Without it, "brand name only" falls back to "describe it".
BRAVE_SEARCH_API_KEY=

# ---- Storage ----
# local (development) | azure (production: Azure Blob Storage) | s3 (any S3-compatible store)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Azure portal → Storage account → Security + networking → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=aidopost
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Payments ----
# paddle (default): Paddle is the Merchant of Record — charges cards/PayPal/Apple Pay, handles VAT,
# and pays out to your own bank account. stripe: alternative if you have a Stripe account.
BILLING_PROVIDER=paddle

# Paddle → Developer tools → Authentication (API key + client-side token)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
# Paddle → Developer tools → Notifications → your destination's secret key
PADDLE_WEBHOOK_SECRET=
# Paddle → Catalog → Products → price IDs (pri_…)
PADDLE_PRICE_LITE_MONTHLY=
PADDLE_PRICE_LITE_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_HD_IMAGE=
PADDLE_PRICE_CREDIT_PACK=

# Only when BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LITE_MONTHLY=
STRIPE_PRICE_LITE_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_HD_IMAGE=
STRIPE_PRICE_CREDIT_PACK=
STRIPE_TAX=false

# ---- Analytics / monitoring (optional) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
