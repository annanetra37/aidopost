{
  "name": "aidopost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "prisma generate && next build",
    "build:worker": "prisma generate && esbuild worker/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/worker.js",
    "start": "next start",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "pipeline:try": "tsx scripts/try-pipeline.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@google/genai": "^3.0.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.0",
    "heic-convert": "^2.1.0",
    "ioredis": "^6.0.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "node-html-parser": "^9.0.7",
    "posthog-js": "^1.447.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
