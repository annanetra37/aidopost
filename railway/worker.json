{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": ["worker/**", "src/lib/**", "prisma/**", "package*.json", "Dockerfile.worker"]
  },
  "deploy": {
    "startCommand": "node dist/worker.js",
    "healthcheckPath": "/",
    "restartPolicyType": "ALWAYS"
  }
}
